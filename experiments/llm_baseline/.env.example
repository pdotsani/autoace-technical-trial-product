# RunPod pod running Qwen2.5-Omni-7B via vLLM.
# Either set RUNPOD_POD_ID (+ optional RUNPOD_PORT), or RUNPOD_BASE_URL to override.
RUNPOD_POD_ID=
RUNPOD_PORT=8000
# RUNPOD_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1

# Only needed if vLLM was started with --api-key
VLLM_API_KEY=

MODEL=Qwen/Qwen2.5-Omni-7B
REQUEST_TIMEOUT=300

# If set, results are also written to <OUTPUT_DIR>/<audio-name>.json
OUTPUT_DIR=

{
  "name": "@autoace/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Code shared by api/ and web/: result schema, batch validation, API types",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./validation": "./src/validation/index.ts",

# Public values only: everything prefixed VITE_ ends up in the browser bundle.

# mock = in-memory API in the browser (no network); live = the deployed API at VITE_API_URL
VITE_API_MODE=mock
# API Gateway endpoint, e.g. https://abc123.execute-api.us-east-2.amazonaws.com (no trailing slash)
VITE_API_URL=

# mock = any email/password signs in as a fake user; supabase = Supabase email/password sign-in
VITE_AUTH_MODE=mock
VITE_SUPABASE_URL=
# The anon (public) key. Never put the service_role key here.
VITE_SUPABASE_ANON_KEY=
